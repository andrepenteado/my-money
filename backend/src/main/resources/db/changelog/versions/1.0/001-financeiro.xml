<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1.0-001-lancamento-parcela" author="andrepenteado">
        <createTable tableName="lancamento">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" primaryKeyName="pk_lancamento" nullable="false"/></column>
            <column name="descricao" type="TEXT"><constraints nullable="false"/></column>
            <column name="pessoa" type="TEXT"><constraints nullable="false"/></column>
            <column name="valor" type="DECIMAL(19,2)"><constraints nullable="false"/></column>
            <column name="data" type="DATE"><constraints nullable="false"/></column>
            <column name="recorrencia" type="INTEGER"><constraints nullable="false"/></column>
            <column name="tipo" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="forma_pagamento" type="VARCHAR(255)"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="parcela">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" primaryKeyName="pk_parcela" nullable="false"/></column>
            <column name="fk_lancamento" type="BIGINT"><constraints nullable="false"/></column>
            <column name="numero" type="INTEGER"><constraints nullable="false"/></column>
            <column name="competencia" type="DATE"><constraints nullable="false"/></column>
            <column name="ajustada" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="data_vencimento" type="DATE"><constraints nullable="false"/></column>
            <column name="valor_vencimento" type="DECIMAL(19,2)"><constraints nullable="false"/></column>
            <column name="data_efetiva" type="DATE"/>
            <column name="valor_efetivo" type="DECIMAL(19,2)"/>
            <column name="forma_pagamento" type="VARCHAR(255)"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="parcela" baseColumnNames="fk_lancamento" referencedTableName="lancamento" referencedColumnNames="id" constraintName="fk_parcela_lancamento" onDelete="CASCADE"/>
        <addUniqueConstraint tableName="parcela" columnNames="fk_lancamento,numero" constraintName="uk_parcela_ocorrencia"/>
        <createIndex tableName="lancamento" indexName="idx_lancamento_data"><column name="data"/></createIndex>
        <createIndex tableName="parcela" indexName="idx_parcela_lancamento"><column name="fk_lancamento"/></createIndex>
        <createIndex tableName="parcela" indexName="idx_parcela_vencimento"><column name="data_vencimento"/></createIndex>
        <createIndex tableName="parcela" indexName="idx_parcela_efetiva"><column name="data_efetiva"/></createIndex>
        <sql>
            ALTER TABLE lancamento ADD CONSTRAINT ck_lancamento_valor CHECK (valor &gt; 0),
                ADD CONSTRAINT ck_lancamento_recorrencia CHECK (recorrencia &gt;= 0),
                ADD CONSTRAINT ck_lancamento_tipo CHECK (tipo IN ('RECEITA', 'DESPESA')),
                ADD CONSTRAINT ck_lancamento_forma CHECK (forma_pagamento IN ('PIX', 'TRANSFERENCIA_BANCARIA', 'CARTAO_CREDITO', 'CARTAO_DEBITO'));
            ALTER TABLE parcela ADD CONSTRAINT ck_parcela_valor_previsto CHECK (valor_vencimento &gt; 0),
                ADD CONSTRAINT ck_parcela_efetivacao CHECK ((data_efetiva IS NULL AND valor_efetivo IS NULL) OR (data_efetiva IS NOT NULL AND valor_efetivo IS NOT NULL AND valor_efetivo &gt; 0)),
                ADD CONSTRAINT ck_parcela_forma CHECK (forma_pagamento IN ('PIX', 'TRANSFERENCIA_BANCARIA', 'CARTAO_CREDITO', 'CARTAO_DEBITO'));
        </sql>
        <rollback><dropTable tableName="parcela"/><dropTable tableName="lancamento"/></rollback>
    </changeSet>
</databaseChangeLog>
